# ---- 复制为 .env 后按需修改，切勿提交 .env 到 Git ----
# 运行环境: development | production
NODE_ENV=development
# 服务端口
PORT=3000
# 对外访问地址（用于拼接密码重置链接）
APP_URL=http://localhost:3000

# JWT 签名密钥：生产环境必须设置足够长的随机字符串！
# 生成方法: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# SQLite 数据库文件路径
DB_PATH=./data/app.db

# 初始管理员种子（仅在数据库为空时生效）
SEED_ADMIN_EMAIL=admin@marsgeek.local
SEED_ADMIN_PASSWORD=MarsGeek2026!ChangeMe
# 是否允许使用上方默认种子创建管理员；生产环境请设为 false 并改用 npm run create-admin
ALLOW_DEFAULT_ADMIN=true

# 密码重置邮件（暂未接真实 SMTP 时，重置链接会打印到服务端控制台）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@marsgeek.local

# 将来如需接入 Skiv(原 Muse.ai) 媒体能力，API Key 只放在这里，后端调用
# SKIV_API_KEY=
